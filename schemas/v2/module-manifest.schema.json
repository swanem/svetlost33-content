{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://svetlost33.example/schemas/m0-v2/module-manifest.schema.json",
  "title":"Svetlost33 M0 v2 module manifest",
  "type":"object","additionalProperties":false,
  "required":["schema_version","module_id","module_type","version","revision","key_id","capabilities","dependencies","files"],
  "properties":{
    "schema_version":{"const":"svetlost33-module-manifest-2"},"module_id":{"$ref":"#/$defs/id"},"module_type":{"enum":["library","cycles","calendar","backgrounds","organizations"]},"version":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":1},"key_id":{"$ref":"#/$defs/id"},
    "capabilities":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/capability"}},
    "dependencies":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["module_id","version"],"properties":{"module_id":{"$ref":"#/$defs/id"},"version":{"$ref":"#/$defs/id"}}}},
    "files":{"type":"array","minItems":1,"maxItems":512,"items":{"type":"object","additionalProperties":false,"required":["path","bytes","sha256","content_type"],"properties":{"path":{"$ref":"#/$defs/path"},"bytes":{"type":"integer","minimum":1,"maximum":20971520},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"content_type":{"enum":["application/json","image/png","image/jpeg"]},"encoding":{"const":"utf-8"},"image":{"type":"object","additionalProperties":false,"required":["width","height"],"properties":{"width":{"type":"integer","minimum":1,"maximum":4096},"height":{"type":"integer","minimum":1,"maximum":4096}}}}}}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,63}$"},"capability":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},"path":{"type":"string","minLength":1,"maxLength":160}}
}
